# Vercel requires a persistent PostgreSQL database. Use the same DATABASE_URL as the Python app.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
GEMINI_API_KEY=
OPENROUTER_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
